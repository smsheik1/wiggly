{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ShazMultiShotTimelineV1",
  "type": "object",
  "required": [
    "schemaVersion",
    "title",
    "audioFile",
    "totalDurationFrames",
    "shots"
  ],
  "properties": {
    "schemaVersion": {
      "const": "shaz-multi-shot-v1"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "audioFile": {
      "type": "string",
      "description": "Path to audio file staged in the run folder"
    },
    "totalDurationFrames": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1800,
      "description": "Total frames in sequence; must match round(measuredAudioDuration * 24)"
    },
    "planningTranscriptSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "SHA256 checksum of the planning transcript generated by whisper.cpp"
    },
    "shots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": [
          "id",
          "shotType",
          "startFrame",
          "endFrameExclusive"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "shotType": {
            "enum": [
              "talk-to-camera",
              "text-card",
              "chibi-commentary",
              "b-roll"
            ]
          },
          "motion": {
            "enum": [
              "zoom-in",
              "zoom-out",
              "pan-left",
              "pan-right",
              "pan-up",
              "pan-down"
            ],
            "description": "Ken Burns camera motion for b-roll shot; defaults to zoom-in"
          },
          "brollMedia": {
            "type": "string",
            "description": "Optional custom concept image for b-roll shot; defaults to scene background"
          },
          "chibiPose": {
            "type": "string",
            "description": "Pose ID from assets.json#chibiFrames; defaults to present-open"
          },
          "topicMedia": {
            "type": "string",
            "description": "Image path or background for the topic being commented on"
          },
          "card": {
            "type": "object",
            "description": "Declarative vector topic card to generate on-the-fly",
            "required": ["badge", "headline"],
            "properties": {
              "badge": { "type": "string", "maxLength": 40 },
              "headline": { "type": "string", "maxLength": 50 },
              "quote": { "type": "string", "maxLength": 80 },
              "theme": { "enum": ["warm-red", "cold-blue", "energy-orange", "deep-purple", "emerald-green", "sunburst-gold"] },
              "icon": { "enum": ["burger", "puppy", "clash", "trophy", "question", "heart-paw", "idea", "star"] },
              "image": { "type": "string" }
            }
          },
          "startFrame": {
            "type": "integer",
            "minimum": 0
          },
          "endFrameExclusive": {
            "type": "integer",
            "minimum": 1
          },
          "backgroundId": {
            "type": "string",
            "description": "Registered background from assets.json; defaults to sisters-room"
          },
          "poseId": {
            "type": "string",
            "description": "Pose ID from poses/index.json for talk-to-camera shots (e.g. neutral-listening, present, aha, confident, shrug); defaults to neutral-listening"
          },
          "text": {
            "type": "string",
            "description": "Text content to render for text-card shot"
          },
          "highlights": {
            "type": "array",
            "description": "Words or phrases in text to highlight with specific accent colors",
            "items": {
              "type": "object",
              "required": ["phrase", "color"],
              "properties": {
                "phrase": { "type": "string" },
                "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
              }
            }
          },
          "rationale": {
            "type": "string",
            "description": "Director rationale explaining why this shot type was chosen at this moment"
          }
        }
      }
    }
  }
}
