{
  "runtime": {
    "node": ">=22",
    "binaries": ["ffmpeg", "ffprobe"],
    "install": "npm install"
  },
  "secretPolicy": {
    "source": "secrets.env",
    "forbidden": [".env.local"],
    "rule": "Read secrets in memory only from repo-root secrets.env. Never log or persist."
  },
  "providers": [
    {
      "id": "gemini-tts",
      "purpose": "Two-speaker dialogue voice",
      "model": "gemini-3.1-flash-tts-preview",
      "environmentVariable": "GEMINI_API_KEY",
      "requiredFor": ["generate"],
      "notRequiredFor": ["check", "init", "prompt", "validate", "estimate", "smoke", "render with packaged fixture", "inspect"],
      "approvalFlag": "--approve-voice",
      "automaticRetry": false,
      "pricing": {
        "source": "https://ai.google.dev/gemini-api/docs/pricing",
        "paidAudioOutputPerMillionTokensUsd": 20,
        "audioTokensPerSecond": 25,
        "estimatedCostPerSecondUsd": 0.0005,
        "freeTierMayApply": true
      }
    },
    {
      "id": "social-publisher",
      "name": "Social Publisher (Buffer MCP or API)",
      "purpose": "Simultaneous multi-platform publishing to YouTube Shorts, Instagram Reels, TikTok, and X.",
      "environmentVariable": "BUFFER_API_KEY",
      "requiredFor": ["distribution"],
      "optional": true,
      "providerCost": "Free tier available / BYOK"
    }
  ],
  "explicitlyNotUsed": [
    "Replicate",
    "image generation",
    "video generation",
    "music generation"
  ]
}
