{
  "name": "wiggly-animal-conversations-format-kit",
  "private": true,
  "version": "0.17.0",
  "type": "module",
  "scripts": {
    "test": "node --test converter/tests/manifests.test.mjs converter/tests/render_tvg.test.mjs converter/tests/runtime_channels.test.mjs converter/tests/scene_transforms.test.mjs runtime/tests/*.test.mjs",
    "test:converter": "node --test converter/tests/scene_runtime_manifest.test.mjs converter/tests/scene_transform_summary.test.mjs && node converter/run_cargo_test.mjs",
    "test:release": "WIGGLY_REVIEW_MEDIA_TESTS=1 WIGGLY_QUALITY_MEDIA_TESTS=1 WIGGLY_WORKFLOW_MEDIA_TESTS=1 WIGGLY_CLI_MEDIA_TESTS=1 WIGGLY_TEST_ARCHIVE=1 npm test && npm run test:converter",
    "doctor": "node runner.mjs doctor",
    "setup:intake": "node runner.mjs setup-intake",
    "status": "node runner.mjs status",
    "run": "node runner.mjs run",
    "export": "node runner.mjs export",
    "check": "node runner.mjs check",
    "smoke": "node runner.mjs smoke",
    "convert": "node converter/convert_pose.mjs",
    "validate": "node runner.mjs validate",
    "render": "node runner.mjs render",
    "inspect": "node runner.mjs inspect",
    "finalize": "node runner.mjs finalize",
    "publish": "node runtime/publish.mjs",
    "build:kit": "node build-kit.mjs"
  },
  "dependencies": {
    "sharp": "0.35.3"
  }
}
